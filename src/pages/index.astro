---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Masthead from '../components/Masthead.astro';
import Contents from '../components/Contents.astro';
import Chapter from '../components/Chapter.astro';
import AlsoBuilt from '../components/AlsoBuilt.astro';
import Colophon from '../components/Colophon.astro';
import { site } from '../data/site';
import { getPublishedPosts } from '../lib/writing';

const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
const showWriting = (await getPublishedPosts()).length > 0;
---
<Base title={site.name} description={site.tagline}>
  <Nav slot="nav" showWriting={showWriting} />
  <Masthead />
  <Contents chapters={chapters} />
  {chapters.map((entry) => (
    <Chapter entry={entry}>
      {entry.data.numeral === 'v' && (
        <p class="contact">
          Write to <a href={`mailto:${site.email}`}>{site.email}</a>.{' '}
          I am also on <a href={site.links.linkedin}>LinkedIn</a> and <a href={site.links.github}>GitHub</a>.{' '}
          {site.links.calendar && <>Or <a href={site.links.calendar}>book a time</a>.{' '}</>}
          The formal version is the <a href={site.links.resume}>resume (PDF)</a>.
        </p>
      )}
    </Chapter>
  ))}
  <AlsoBuilt />
  <Colophon slot="colophon" />
</Base>
