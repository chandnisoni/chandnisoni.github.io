---
// The running header: shows the current chapter title once the reader scrolls past the masthead.
// This is the only script on the home page. Without it, nothing is lost.
---
<header class="running sans" aria-hidden="true"><span data-running></span></header>
<script>
  const el = document.querySelector('[data-running]');
  const header = document.querySelector('header.running');
  const chapters = document.querySelectorAll('section.chapter');
  const masthead = document.querySelector('.masthead');
  if (el && header && chapters.length && masthead && 'IntersectionObserver' in window) {
    const titles = new Map();
    for (const c of chapters) titles.set(c, c.querySelector('h2')?.textContent?.replace(/\s+/g, ' ').trim() ?? '');
    let current = null;
    const chapterObserver = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) current = e.target;
        if (current) el.textContent = titles.get(current) ?? '';
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );
    for (const c of chapters) chapterObserver.observe(c);
    new IntersectionObserver(([e]) => header.classList.toggle('visible', !e.isIntersecting)).observe(masthead);
  }
</script>
