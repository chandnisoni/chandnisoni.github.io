---
import { assertImageExists } from '../lib/images';
interface Props { src: string; alt: string; caption: string; width: number; height: number; wide?: boolean }
const { src, alt, caption, width, height, wide = false } = Astro.props;
assertImageExists(src);
---
<figure class:list={['figure', { wide }]}>
  <img src={src} alt={alt} width={width} height={height} />
  <figcaption>{caption}</figcaption>
</figure>
