---
import type { CollectionEntry } from 'astro:content';
import Figure from './Figure.astro';
interface Props { entry: CollectionEntry<'chapters'> }
const { entry } = Astro.props;
const { data } = entry;
const n = data.numeral;
const LETTER: Record<string, string> = { 'edgar-miner': 'A', 'fundraising-agent': 'B', 'thinkmocha': 'C' };
const appendices = (data.appendices ?? []).map((slug) => ({ slug, letter: LETTER[slug] ?? '?' }));

// The markdown processor emits an <h2> "Footnotes" label with one fixed id per document.
// Chapters share a page, so: make the label a span (book footnotes have no heading, and it
// must not count as a chapter heading) and suffix the id so each chapter's refs point home.
const raw = entry.rendered?.html ?? '';
const fixed = raw
  .replace(/<h2 class="sr-only" id="footnote-label">Footnotes<\/h2>/, `<span class="sr-only" id="footnote-label-${n}">Footnotes</span>`)
  .replaceAll('aria-describedby="footnote-label"', `aria-describedby="footnote-label-${n}"`);
const cut = fixed.indexOf('<section data-footnotes');
const body = cut === -1 ? fixed : fixed.slice(0, cut);
const footnotes = cut === -1 ? '' : fixed.slice(cut);
---
<section class="chapter" id={n}>
  <h2><span class="numeral">{n}.</span> {data.title}</h2>
  {data.image && <Figure {...data.image} />}
  <Fragment set:html={body} />
  <slot />
  {appendices.length > 0 && (
    <p class="see-also sans">
      {appendices.map(({ slug, letter }, i) => (
        <>{i > 0 && ' · '}<a href={`/work/${slug}/`}>Appendix {letter} →</a></>
      ))}
    </p>
  )}
  <Fragment set:html={footnotes} />
</section>
